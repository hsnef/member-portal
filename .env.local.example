# ============================================================================
# HSNEF Member Portal — local environment
# ============================================================================
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Never commit real values.
#
# This file lists every variable the CODE ACTUALLY READS, and nothing else.
# If you add a `process.env.X` anywhere, add it here in the same change --
# a new developer's first hour should not be spent discovering a missing key
# from a stack trace.
#
# Verify the list is still complete with:
#   grep -rhoE "process\.env\.[A-Z0-9_]+" app components lib utils middleware.ts \
#     | sed 's/process\.env\.//' | sort -u
#
# ============================================================================


# ============================================================================
# SUPABASE  — required
# ============================================================================
#
# ⚠️  POINT AT THE **DEV** PROJECT. Getting this wrong writes to real member data.
#
#     dev   dev-mp    bcujsesgrzijyisvmnwm   <-- use this one
#     prod  prod-mp   gapvsdrzavjaublwkqfm   <-- NOT this one
#
# `gapvsdrzavjaublwkqfm` is PRODUCTION. It was the single shared project before
# the 2026-09-02 split and it kept its ref, so older notes and docs show it as
# "dev". They are wrong. See DEC-006 in docs/PROJECT-HUB.md.
#
# Values: Supabase dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://bcujsesgrzijyisvmnwm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# Server-side only, bypasses RLS. Never expose to the client, never log it.
# `createServiceClient()` in lib/supabase/client.ts throws without it.
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key


# ============================================================================
# STRIPE  — STRIPE_SECRET_KEY is required; the others are optional locally
# ============================================================================
#
# Use TEST keys (sk_test_… / pk_test_…). https://dashboard.stripe.com/apikeys
#
# lib/stripe/config.ts throws AT IMPORT TIME without STRIPE_SECRET_KEY, so any
# route touching Stripe returns a 500 rather than degrading. Set it even if you
# are not working on payments.

STRIPE_SECRET_KEY=sk_test_your-test-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-test-publishable-key

# Only needed to exercise the webhook locally. Defaults to '' and signature
# verification then fails, which is the safe direction.
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret


# ============================================================================
# TOKEN SECRETS  — required
# ============================================================================
#
# Generate your own:  openssl rand -base64 32
#
# Both have insecure hardcoded fallbacks, so a missing value FAILS OPEN rather
# than loudly. Set them.
#
# NOTE: locally generated secrets do not match dev's, so a QR pass issued by
# dev.member.hsnef.org will not verify against your local server. To test
# against real passes, copy dev's QR_TOKEN_SECRET out of Vercel.

QR_TOKEN_SECRET=generate-a-long-random-string
# Falls back to QR_TOKEN_SECRET when unset; set it separately so rotating one
# does not silently rotate the other.
ZELLE_TOKEN_SECRET=generate-a-different-long-random-string


# ============================================================================
# EMAIL (Resend)  — optional locally
# ============================================================================
#
# Without RESEND_API_KEY the app runs fine and send attempts return an error
# instead of throwing. Set it only if you are working on email.
# Key: https://resend.com/api-keys

RESEND_API_KEY=re_your-resend-api-key

# ⚠️  LEAVE THE DOMAIN AS portal.hsnef.org.
#
# It looks stale next to member.hsnef.org, and it is not. `portal.hsnef.org`
# carries the `resend._domainkey` TXT record, so it is the VERIFIED SENDING
# domain; `member.hsnef.org` serves the app but is NOT verified in Resend.
# Changing this to member.hsnef.org breaks email sending. The domain does two
# different jobs and only one of them moved.
EMAIL_FROM=noreply@portal.hsnef.org
EMAIL_FROM_NAME=HSNEF Membership Portal
EMAIL_REPLY_TO=info@hsnef.org


# ============================================================================
# APP URL  — optional, defaults to http://localhost:3000
# ============================================================================
#
# Used to build QR-code and Zelle payment links.
#   local  http://localhost:3000
#   dev    https://dev.member.hsnef.org
#   prod   https://member.hsnef.org

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================================
# CRON  — optional locally
# ============================================================================
#
# Only /api/cron/cleanup-login-logs reads it, and that route returns 500 when
# it is unset. Needed on deployed environments, not for local work.

CRON_SECRET=generate-a-long-random-string


# ============================================================================
# NOT SET HERE
# ============================================================================
#
# NODE_ENV, VERCEL_GIT_COMMIT_REF, GITHUB_REF_NAME
#   Provided by Next.js, Vercel and GitHub Actions. Do not set them by hand.
#
# COMPLIANCE_DOC_REVIEWED
#   Read by scripts/sdlc-docs.mjs (the doc-sync gate), not by the app.
#   Set it in CI when a compliance doc has genuinely been reviewed.
#
# ============================================================================
