# ============================================================================
# HSNEF Membership Portal - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection string (optional, for direct DB access)
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production

# Publishable key (safe to expose to client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Secret key (server-side only)
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Webhook signing secret (from Stripe webhook settings)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Product/Price IDs (create these in Stripe Dashboard)
STRIPE_ANNUAL_MEMBERSHIP_PRICE_ID=price_annual_membership
STRIPE_LIFETIME_MEMBERSHIP_PRICE_ID=price_lifetime_membership

# ============================================================================
# OPENROUTER / LLM CONFIGURATION
# ============================================================================
# For member chatbot functionality
# Get API key from: https://openrouter.ai/keys

OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Specific model to use (defaults to a cost-effective model)
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ============================================================================
# EMAIL CONFIGURATION (RESEND)
# ============================================================================
# Get API key from: https://resend.com/api-keys

RESEND_API_KEY=re_your-resend-api-key

# From email address (must be verified domain in Resend)
EMAIL_FROM=noreply@members.hsnef.org
EMAIL_FROM_NAME=HSNEF Membership Portal

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application URL (used for generating links in emails, QR codes, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://members.hsnef.org

# Main HSNEF website URL
NEXT_PUBLIC_MAIN_SITE_URL=https://hsnef.org

# Session configuration
SESSION_MAX_AGE=43200
# Session max age in seconds (default: 12 hours = 43200 seconds)

SESSION_INACTIVITY_TIMEOUT=3600
# Inactivity timeout in seconds (default: 1 hour = 3600 seconds)

# ============================================================================
# SECURITY & SECRETS
# ============================================================================

# Next.js secret for signing cookies/sessions
NEXTAUTH_SECRET=your-random-secret-here-generate-with-openssl-rand-base64-32

# JWT secret for custom token signing (optional)
JWT_SECRET=your-jwt-secret-here

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================

# Enable/disable specific features
NEXT_PUBLIC_ENABLE_VOTING=false
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_QR_CHECKIN=true

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Node environment
NODE_ENV=development
# Production: production

# Enable debug logging
DEBUG=false

# Disable telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# QUICKBOOKS INTEGRATION (Phase 2 - Optional)
# ============================================================================

# QuickBooks OAuth credentials (for future integration)
# QUICKBOOKS_CLIENT_ID=your-client-id
# QUICKBOOKS_CLIENT_SECRET=your-client-secret
# QUICKBOOKS_REDIRECT_URI=https://members.hsnef.org/api/quickbooks/callback

# ============================================================================
# SMS/NOTIFICATIONS (Optional - Future)
# ============================================================================

# Twilio for SMS notifications (optional)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================

# Google Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# NOTES
# ============================================================================
#
# 1. SUPABASE SETUP:
#    - Create a new Supabase project at https://app.supabase.com
#    - Run migrations in supabase/migrations/ to set up the schema
#    - Enable Google OAuth in Authentication > Providers
#    - Configure email templates in Authentication > Email Templates
#
# 2. STRIPE SETUP:
#    - Create products for Annual and Lifetime memberships
#    - Set up webhook endpoint: https://your-domain/api/webhooks/stripe
#    - Events to listen: payment_intent.succeeded, checkout.session.completed
#
# 3. RESEND SETUP:
#    - Verify your domain (members.hsnef.org)
#    - Add DNS records as instructed by Resend
#
# 4. OPENROUTER SETUP:
#    - Create account and get API key
#    - Monitor usage and set limits as needed
#
# 5. SECURITY REMINDERS:
#    - Never commit .env.local to git
#    - Use different secrets for dev/staging/prod
#    - Rotate secrets regularly
#    - Use environment-specific Stripe keys (test vs live)
#
# ============================================================================
