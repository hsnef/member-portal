{
  "name": "hsnef-membership-portal",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "generate-version": "tsx scripts/generate-version.ts",
    "dev": "npm run generate-version && next dev",
    "build": "npm run generate-version && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-hooks": "git config core.hooksPath .githooks || exit 0",
    "prepare": "npm run setup-hooks && npm run generate-version",
    "release-gate": "tsx scripts/release-gate.ts",
    "release-gate:full": "tsx scripts/release-gate.ts --full",
    "docs:sync-check": "node scripts/docs-sync-check.mjs",
    "docs:sync-check:ci": "node scripts/docs-sync-check.mjs --ci",
    "docsync:audit": "node scripts/govkit-docsync.mjs audit --warn",
    "sdlc-docs:audit": "npm run docsync:audit",
    "docsync:gate": "node scripts/govkit-docsync.mjs audit --gate",
    "sdlc-docs:gate": "npm run docsync:gate",
    "docsync:report": "node scripts/govkit-docsync.mjs report",
    "sdlc-docs:report": "npm run docsync:report",
    "govkit:doctor": "node scripts/govkit-doctor.mjs",
    "govkit:config": "node scripts/govkit-doctor.mjs config",
    "supabase:auth-config": "tsx --env-file-if-exists=.env.local scripts/supabase-auth-config.ts",
    "release:status": "node scripts/release-version.mjs status",
    "release:bump": "node scripts/release-version.mjs bump",
    "release:tag": "node scripts/release-version.mjs tag",
    "db:sql": "node --env-file-if-exists=.env.local scripts/db-sql.mjs",
    "docs:check": "docs-kit check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-link": "^3.15.3",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-underline": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@zxing/library": "^0.21.3",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.38.0",
    "next": "^15.1.4",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.70.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.6.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "docs-kit": "github:techsilon-oss/docs-kit#v0.2.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
